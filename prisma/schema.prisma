generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
  //shadowDatabaseUrl = env("POSTGRES_URL_NON_POOLING") // used for migrations
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  NEW
  PRODUCING
  PENDING
  DELIVERED
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email    String  @unique
  password String
  phone    String? @unique
  cpf      String? @unique
  nome     String?
  birthday String?
  role     Role    @default(USER)

  business             Business[]
  transactionsAsUser   Transaction[] @relation("userTransactions")
  transactionsAsOrigin Transaction[] @relation("originTransactions")
  Product              Product[]
  productId            String?
  Order                Order[]
  Address              Address[]
  Contact              Contact[]

  @@map("user")
}

model Business {
  id          String        @id @default(uuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Products    Product[]
  Transaction Transaction[]
  Owner       User          @relation(fields: [OwnerId], references: [id])
  OwnerId     String

  whatsapp String?
  email    String?

  Image   Image?
  imageId String?

  Address   Address?
  addressId String?

  name        String
  description String?
  slug        String  @unique @default(uuid())
  logo_url    String?
  Order       Order[]

  @@map("business")
}

model Product {
  id             String           @id @default(uuid())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  name           String           @unique
  description    String
  price          Int
  Business       Business         @relation(fields: [businessId], references: [id])
  businessId     String
  User           User             @relation(fields: [userId], references: [id])
  userId         String
  images         Image[]
  ProductOnOrder ProductOnOrder[]

  @@map("product")
}

model Image {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bytes             Int
  secure_url        String
  original_filename String
  public_id         String
  etag              String

  Product    Product?  @relation(fields: [productId], references: [id])
  productId  String?
  Business   Business? @relation(fields: [businessId], references: [id])
  businessId String?   @unique

  @@map("image")
}

model ProductOnOrder {
  product  Product @relation(fields: [id], references: [id])
  id       String // relation scalar field (used in the `@relation` attribute above)
  order    Order   @relation(fields: [orderId], references: [id])
  orderId  String // relation scalar field (used in the `@relation` attribute above)
  quantity Int

  @@id([id, orderId])
}

model Contact {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nome      String
  celular   String
  whatsapp  Boolean
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
  Order     Order[]

  @@map("contact")
}

model Order {
  id             String           @id @default(uuid())
  createdAt      DateTime         @default(now())
  ProductOnOrder ProductOnOrder[]
  Business       Business         @relation(fields: [businessId], references: [id])
  businessId     String
  User           User?            @relation(fields: [userId], references: [id])
  userId         String?
  contact        Contact?         @relation(fields: [contactId], references: [id])
  address        Address?         @relation(fields: [addressId], references: [id])
  contactId      String?
  addressId      String?
  status         OrderStatus      @default(NEW)

  @@map("order")
}

model Address {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  cep         String
  estado      Int
  cidade      Int
  endereco    String
  bairro      String
  numero      Int?
  complemento String
  Order       Order[]
  User        User?    @relation(fields: [userId], references: [id])
  orderId     String?
  userId      String?

  Business   Business? @relation(fields: [businessId], references: [id])
  businessId String?   @unique

  @@map("address")
}

model Transaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation("userTransactions", fields: [userId], references: [id])
  origin   User     @relation("originTransactions", fields: [originId], references: [id])

  amount     Float
  businessId String
  userId     String
  originId   String

  @@map("transaction")
}
