generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("POSTGRES_PRISMA_URL")
  directUrl         = env("POSTGRES_URL_NON_POOLING")
  shadowDatabaseUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                     String        @id @default(uuid())
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  email                  String        @unique
  password               String
  phone                  String?       @unique
  cpf                    String?       @unique
  nome                   String?
  birthday               String?
  role                   Role          @default(USER)
  plan                   Plan          @default(FREE)
  stripe_costumer_id     String?
  stripe_subscription_id String?
  productId              String?
  reset_token            ResetToken[]
  Address                Address[]
  business               Business[]
  Contact                Contact[]
  Order                  Order[]
  Product                Product[]
  transactionsAsOrigin   Transaction[] @relation("originTransactions")
  transactionsAsUser     Transaction[] @relation("userTransactions")

  @@map("user")
}

model ResetToken {
  status    TokenStatus @default(PENDING)
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  userId    String
  User      User        @relation(fields: [userId], references: [id])
}

model Business {
  id          String        @id @default(uuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  OwnerId     String
  theme       Theme         @default(light)
  visible     Boolean       @default(true)
  banned      Boolean       @default(false)
  whatsapp    String?
  email       String?
  imageId     String?
  addressId   String?
  name        String
  description String?
  slug        String        @unique @default(uuid())
  logo_url    String?
  Address     Address?
  Owner       User          @relation(fields: [OwnerId], references: [id])
  Image       Image?
  Order       Order[]
  Products    Product[]
  Transaction Transaction[]

  @@map("business")
}

model Product {
  id             String           @id @default(uuid())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  name           String           @unique
  description    String
  price          Float
  businessId     String
  userId         String
  ProductOnOrder ProductOnOrder[]
  images         Image[]
  Business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  User           User             @relation(fields: [userId], references: [id])

  @@map("product")
}

model Image {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bytes       Int?
  Key         String
  productId   String?
  businessId  String?   @unique
  description String?
  Business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  Product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("image")
}

model ProductOnOrder {
  id       String
  orderId  String
  quantity Int
  product  Product @relation(fields: [id], references: [id], onDelete: Cascade)
  order    Order   @relation(fields: [orderId], references: [id])

  @@id([id, orderId])
}

model Contact {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nome      String
  celular   String
  whatsapp  Boolean
  userId    String?
  User      User?    @relation(fields: [userId], references: [id])
  Order     Order[]

  @@map("contact")
}

model Order {
  id             String           @id @default(uuid())
  createdAt      DateTime         @default(now())
  businessId     String
  userId         String?
  contactId      String?
  addressId      String?
  status         OrderStatus      @default(NEW)
  ProductOnOrder ProductOnOrder[]
  address        Address?         @relation(fields: [addressId], references: [id])
  Business       Business         @relation(fields: [businessId], references: [id])
  contact        Contact?         @relation(fields: [contactId], references: [id])
  User           User?            @relation(fields: [userId], references: [id])

  @@map("order")
}

model Address {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  cep         String
  estado      Int
  cidade      Int
  endereco    String
  bairro      String
  numero      Int?
  complemento String
  orderId     String?
  userId      String?
  businessId  String?   @unique
  Business    Business? @relation(fields: [businessId], references: [id])
  User        User?     @relation(fields: [userId], references: [id])
  Order       Order[]

  @@map("address")
}

model Transaction {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  amount     Float
  businessId String
  userId     String
  originId   String
  business   Business @relation(fields: [businessId], references: [id])
  origin     User     @relation("originTransactions", fields: [originId], references: [id])
  user       User     @relation("userTransactions", fields: [userId], references: [id])

  @@map("transaction")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  BASIC
  ADVANCED
  AGENCY
}

enum OrderStatus {
  NEW
  PRODUCING
  PENDING
  DELIVERED
}

enum TokenStatus {
  PENDING
  USED
}

enum Theme {
  light
  dark
  cupcake
  bumblebee
  emerald
  corporate
  synthwave
  retro
  cyberpunk
  valentine
  halloween
  garden
  forest
  aqua
  lofi
  pastel
  fantasy
  wireframe
  black
  luxury
  dracula
  cmyk
  autumn
  business
  acid
  lemonade
  night
  coffee
  winter
}
