generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email    String  @unique
  password String
  phone    String? @unique
  cpf      String? @unique
  nome     String?
  birthday String?
  role     Role    @default(USER)

  business             Business[]
  transactionsAsUser   Transaction[] @relation("userTransactions")
  transactionsAsOrigin Transaction[] @relation("originTransactions")
  Product              Product[]
  productId            String?
  Order                Order[]
  Address              Address[]

  @@map("user")
}

model Business {
  id          String        @id @default(uuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Products    Product[]
  Transaction Transaction[]
  Owner       User          @relation(fields: [OwnerId], references: [id])
  OwnerId     String

  name     String
  slug     String  @unique @default(uuid())
  logo_url String?
  Order    Order[]

  @@map("business")
}

model Product {
  id             String           @id @default(uuid())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  name           String           @unique
  description    String
  price          Int
  Business       Business         @relation(fields: [businessId], references: [id])
  businessId     String
  User           User             @relation(fields: [userId], references: [id])
  userId         String
  images         Image[]
  ProductOnOrder ProductOnOrder[]

  @@map("product")
}

model Image {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bytes             Int
  secure_url        String
  original_filename String
  public_id         String
  etag              String

  Product   Product? @relation(fields: [productId], references: [id])
  productId String?

  @@map("image")
}

model ProductOnOrder {
  product   Product @relation(fields: [productId], references: [id])
  productId String // relation scalar field (used in the `@relation` attribute above)
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String // relation scalar field (used in the `@relation` attribute above)
  quantity  Int

  @@id([productId, orderId])
}

model Order {
  id             String           @id @default(uuid())
  createdAt      DateTime         @default(now())
  ProductOnOrder ProductOnOrder[]
  Business       Business         @relation(fields: [businessId], references: [id])
  businessId     String
  User           User?            @relation(fields: [userId], references: [id])
  userId         String?
  address        Address[]

  @@map("order")
}

model Address {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  cep         String
  estado      Int
  cidade      Int
  endereco    String
  bairro      String
  numero      Int
  complemento String
  Order       Order[]
  User        User?    @relation(fields: [userId], references: [id])
  orderId     String?
  userId      String?
}

model Transaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation("userTransactions", fields: [userId], references: [id])
  origin   User     @relation("originTransactions", fields: [originId], references: [id])

  amount     Float
  businessId String
  userId     String
  originId   String

  @@map("transaction")
}
