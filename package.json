{
  "name": "nuxa.io",
  "private": true,
  "scripts": {
    "build": "npx prisma generate && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "migrate": "prisma migrate dev --name init",
    "migrate:prd": "yarn dotenv -e .env.prd prisma migrate dev --name prd",
    "lint:fix": "eslint --ext .vue,.ts,.js,.mjs . --fix",
    "eslint:github-action": "node ./node_modules/eslint/bin/eslint . --ignore-path .gitignore --max-warnings 0",
    "studio": "yarn prisma studio",
    "studio:prd": "yarn dotenv -e .env.prd yarn prisma studio",
    "stripe:dev": ".stripe/stripe.exe listen --forward-to localhost:3000/api/v1/webhooks",
    "stripe:trigger": ".stripe/stripe.exe trigger customer.subscription.updated",
    "pull": "npx prisma db pull",
    "typecheck": "yarn nuxi typecheck"
  },
  "devDependencies": {
